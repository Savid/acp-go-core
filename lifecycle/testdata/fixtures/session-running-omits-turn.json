{
  "name": "session-running-omits-turn",
  "purpose": "A running foreground is a turn running, so no update may assert one with no turn to own it. A session-caused transition may omit its turn on an idle or a requires_action, never on a running: the omission is a structural defect in the event, judged before any name is resolved, so it is malformed_envelope rather than unknown_entity — a token that reports a name the stream cannot resolve has nothing to report when the event carries no name at all. The refusal is structural, so it touches nothing in the projection.",
  "negotiated": {
    "version": 1,
    "updatesOutsidePrompt": true,
    "activityKinds": [
      "task",
      "subagent"
    ]
  },
  "input": [
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "session_info_update"
        },
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 1,
            "event": {
              "type": "lifecycle_snapshot",
              "foreground": {
                "state": "idle",
                "cycleId": "cyc-0"
              },
              "activities": [],
              "actions": []
            }
          }
        }
      }
    },
    {
      "method": "session/update",
      "params": {
        "sessionId": "sess-1",
        "update": {
          "sessionUpdate": "session_info_update"
        },
        "_meta": {
          "acp-go.dev/lifecycle": {
            "version": 1,
            "streamId": "strm-1",
            "sequence": 2,
            "event": {
              "type": "state_update",
              "state": "running",
              "cycleId": "cyc-1",
              "cause": "session"
            }
          }
        }
      }
    }
  ],
  "expect": {
    "verdict": "fail_closed",
    "violation": "malformed_envelope",
    "atInput": 1,
    "state": {
      "streamId": "strm-1",
      "reducedThrough": 1,
      "suppressedRetransmissions": 0,
      "foreground": {
        "state": "idle",
        "cycleId": "cyc-0"
      },
      "turns": [],
      "activities": [],
      "actions": [],
      "closed": false
    }
  }
}
